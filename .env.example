# 人类访客
FREE_SECONDS=600          # 免费访客每天能看多少秒，默认 600（十分钟）
LAMP_DAYS=30              # 一个灯油码给多少天
# COOKIE_SECURE=1         # 上公网、有 HTTPS 之后打开

# 安全相关。不填会在 data/ 里自动生成。
# SESSION_SECRET=
# WATCHER_KEY=

# 注册确认邮件（不配则只在本地能注册，链接写到 data/mail.log）
# QQ 邮箱示例：SMTP_HOST=smtp.qq.com SMTP_PORT=465，密码填"授权码"不是登录密码
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=长明楼 <you@example.com>

# 服务
PORT=3000
HOST=127.0.0.1
